<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>職能治療國考冒險群島</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
        .island-float { animation: float 4s ease-in-out infinite; }
        body { background-color: #0f172a; margin: 0; overflow-x: hidden; }
        .fade-in { animation: fadeIn 0.5s ease-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        // --- 資料定義 ---
        const ISLANDS = [
            { id: 'anatomy', name: '解剖學島', color: 'bg-red-500', icon: 'Stethoscope', landmark: '脊椎山脈', theme: 'text-red-100', detail: '結構、層次、身體構造' },
            { id: 'physiology', name: '生理學島', color: 'bg-purple-600', icon: 'Brain', landmark: '心臟火山', theme: 'text-purple-100', detail: '動態運作、系統循環' },
            { id: 'theory', name: '職能治療理論島', color: 'bg-emerald-500', icon: 'BookOpen', landmark: '模型神殿', theme: 'text-emerald-50', detail: '模型、框架、抽象思考' },
            { id: 'pediatrics', name: '小兒職能治療島', color: 'bg-yellow-400', icon: 'Baby', landmark: '巨型溜滑梯', theme: 'text-yellow-900', detail: '發展、遊戲、感覺統合' },
            { id: 'psychosocial', name: '身心障礙島', color: 'bg-indigo-900', icon: 'ShieldAlert', landmark: '情緒湖', theme: 'text-indigo-100', detail: '情緒、認知、內在世界' },
            { id: 'physical', name: '生理障礙島', color: 'bg-orange-500', icon: 'RotateCcw', landmark: '復健訓練場', theme: 'text-orange-100', detail: '復健、功能恢復' },
            { id: 'assistive', name: '輔具學島', color: 'bg-slate-400', icon: 'Settings', landmark: '機械塔', theme: 'text-slate-900', detail: '工具、設計、科技輔助' },
            { id: 'random', name: '隨機出題島', color: 'bg-gradient-to-tr from-pink-500 to-cyan-500', icon: 'Compass', landmark: '隨機傳送門', theme: 'text-white', detail: '跨科目整合練習' },
        ];

        const BADGES = [
            { id: 'adhd', name: 'ADHD', category: '小兒', color: 'bg-yellow-400', desc: '亮黃中心小光點' },
            { id: 'asd', name: '自閉症', category: '小兒', color: 'bg-blue-400', desc: '彩色拼圖星球' },
            { id: 'stroke', name: '腦中風', category: '生理', color: 'bg-red-700', desc: '中斷的血管' },
            { id: 'parkinson', name: '帕金森', category: '生理', color: 'bg-purple-800', desc: '震動的手輪廓' },
            { id: 'dementia', name: '失智症', category: '精神', color: 'bg-gray-300', desc: '消散的大腦碎片' },
            { id: 'angelman', name: '天使症候群', category: '精神', color: 'bg-sky-300', desc: '微笑臉與光環' }
        ];

        function App() {
            const [view, setView] = useState('map');
            const [score, setScore] = useState(0);
            const [hearts, setHearts] = useState(5);
            const [selectedIsland, setSelectedIsland] = useState(null);
            const [unlockedBadges, setUnlockedBadges] = useState([]);

            // 模擬 Lucide 圖示渲染
            const Icon = ({ name, size = 24, className = "" }) => {
                useEffect(() => { 
                    if (window.lucide) window.lucide.createIcons(); 
                }, [view, name]);
                return <i data-lucide={name.toLowerCase()} style={{ width: size, height: size }} className={className}></i>;
            };

            const handleIslandClick = (island) => {
                if (hearts <= 0) {
                    alert("生命值不足，請等待恢復！");
                    return;
                }
                setSelectedIsland(island);
                setView('mode-select');
            };

            const handleStartQuiz = () => {
                setHearts(h => Math.max(0, h - 1));
                // 這裡模擬增加積分
                const newScore = score + 20;
                setScore(newScore);
                
                // 檢查是否解鎖新勳章
                const badgeIndex = Math.floor(newScore / 100);
                if (badgeIndex > unlockedBadges.length && badgeIndex <= BADGES.length) {
                    setUnlockedBadges(BADGES.slice(0, badgeIndex));
                }
                
                alert('進入題目練習模式：共 40 題\n(目前為模擬模式，積分已增加 20)');
                setView('map');
            };

            return (
                <div className="min-h-screen text-slate-100 flex flex-col font-sans">
                    {/* 頂部狀態欄 */}
                    <header className="p-4 bg-slate-800/80 backdrop-blur-md flex justify-between items-center sticky top-0 z-50 border-b border-slate-700">
                        <div className="flex items-center space-x-4">
                            <div className="flex space-x-1 bg-slate-900 px-3 py-1.5 rounded-full border border-slate-700">
                                {[...Array(5)].map((_, i) => (
                                    <Icon key={i} name="Heart" size={18} className={i < hearts ? "text-red-500 fill-red-500" : "text-slate-600"} />
                                ))}
                            </div>
                            <div className="bg-slate-900 px-3 py-1.5 rounded-full border border-slate-700 text-yellow-400 flex items-center space-x-2">
                                <Icon name="Trophy" size={18} />
                                <span className="font-bold">{score}</span>
                            </div>
                        </div>
                        <button onClick={() => setView('badges')} className="p-2 bg-slate-700 hover:bg-slate-600 rounded-full transition-colors relative">
                            <Icon name="Award" className="text-cyan-400" />
                            {unlockedBadges.length > 0 && (
                                <span className="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] w-4 h-4 flex items-center justify-center rounded-full">
                                    {unlockedBadges.length}
                                </span>
                            )}
                        </button>
                    </header>

                    {/* 主要內容區域 */}
                    <main className="flex-1 p-6 flex flex-col items-center">
                        {view === 'map' && (
                            <div className="w-full max-w-5xl fade-in">
                                <div className="text-center mb-10">
                                    <h1 className="text-4xl font-black mb-2 bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-500 bg-clip-text text-transparent italic">
                                        職能治療：國考修煉冒險
                                    </h1>
                                    <p className="text-slate-400">點擊島嶼開始修煉，累積積分換取疾病勳章</p>
                                </div>
                                
                                <div className="grid grid-cols-2 md:grid-cols-4 gap-6">
                                    {ISLANDS.map(island => (
                                        <button 
                                            key={island.id}
                                            onClick={() => handleIslandClick(island)}
                                            className={`${island.color} aspect-square rounded-3xl p-6 flex flex-col items-center justify-center shadow-2xl hover:scale-105 transition-transform island-float group relative overflow-hidden`}
                                        >
                                            <div className="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                            <Icon name={island.icon} size={56} className={`mb-4 ${island.theme}`} />
                                            <span className={`text-xl font-bold ${island.theme}`}>{island.name}</span>
                                            <span className={`text-xs mt-2 opacity-80 ${island.theme} border-t border-white/20 pt-2`}>{island.landmark}</span>
                                        </button>
                                    ))}
                                </div>
                            </div>
                        )}

                        {view === 'mode-select' && selectedIsland && (
                            <div className="w-full max-w-md fade-in">
                                <button onClick={() => setView('map')} className="mb-6 flex items-center text-slate-400 hover:text-white transition-colors">
                                    <Icon name="ChevronLeft" /> <span>返回海域地圖</span>
                                </button>
                                
                                <div className={`${selectedIsland.color} p-10 rounded-3xl mb-8 text-center shadow-2xl`}>
                                    <Icon name={selectedIsland.icon} size={80} className={`mx-auto mb-4 ${selectedIsland.theme}`} />
                                    <h2 className={`text-3xl font-bold mb-2 ${selectedIsland.theme}`}>{selectedIsland.name}</h2>
                                    <p className={`text-sm opacity-90 ${selectedIsland.theme}`}>{selectedIsland.detail}</p>
                                </div>

                                <div className="space-y-4">
                                    {[
                                        { n: '隨機練習模式', d: '全題庫隨機抽取' },
                                        { n: '簡單模式', d: '答對率 ≥ 50% 題目' },
                                        { n: '困難模式', d: '答對率 < 50% 題目' },
                                        { n: '錯題統整模式', d: '強化複習弱點' }
                                    ].map(mode => (
                                        <button 
                                            key={mode.n}
                                            onClick={handleStartQuiz}
                                            className="w-full p-5 bg-slate-800 border border-slate-700 rounded-2xl hover:bg-slate-700 hover:border-cyan-500 transition-all text-left flex justify-between items-center group"
                                        >
                                            <div>
                                                <div className="font-bold text-lg group-hover:text-cyan-400">{mode.n}</div>
                                                <div className="text-xs text-slate-500">{mode.d}</div>
                                            </div>
                                            <Icon name="Play" size={20} className="text-slate-600 group-hover:text-cyan-400" />
                                        </button>
                                    ))}
                                </div>
                            </div>
                        )}

                        {view === 'badges' && (
                            <div className="w-full max-w-4xl text-center fade-in">
                                <div className="flex justify-between items-center mb-10">
                                    <button onClick={() => setView('map')} className="flex items-center text-slate-400 hover:text-white">
                                        <Icon name="ChevronLeft" /> <span>返回</span>
                                    </button>
                                    <h2 className="text-3xl font-bold bg-gradient-to-r from-yellow-400 to-amber-600 bg-clip-text text-transparent">成就勳章館</h2>
                                    <div className="w-10"></div>
                                </div>

                                <div className="grid grid-cols-2 md:grid-cols-3 gap-6">
                                    {BADGES.map(b => {
                                        const isUnlocked = unlockedBadges.some(ub => ub.id === b.id);
                                        return (
                                            <div key={b.id} className={`p-8 rounded-3xl border flex flex-col items-center transition-all ${
                                                isUnlocked ? `${b.color} border-transparent shadow-xl scale-100` : 'bg-slate-800/30 border-slate-700 opacity-40 scale-95'
                                            }`}>
                                                <div className={`w-20 h-20 rounded-full flex items-center justify-center mb-4 ${isUnlocked ? 'bg-white/20' : 'bg-slate-700'}`}>
                                                    <Icon name="Award" className={isUnlocked ? "text-white" : "text-slate-500"} size={40} />
                                                </div>
                                                <span className={`text-xl font-bold ${isUnlocked ? 'text-white' : 'text-slate-500'}`}>{b.name}</span>
                                                <span className={`text-[10px] mt-1 px-2 py-0.5 rounded-full ${isUnlocked ? 'bg-black/10 text-white' : 'bg-slate-800 text-slate-600'}`}>
                                                    {b.category}領域
                                                </span>
                                                {isUnlocked && <p className="text-[10px] mt-3 text-white/80">{b.desc}</p>}
                                            </div>
                                        );
                                    })}
                                </div>
                                
                                <div className="mt-12 p-6 bg-slate-800/50 rounded-2xl border border-slate-700 inline-block">
                                    <p className="text-slate-400 text-sm">累積 100 積分可解鎖下一個勳章</p>
                                    <p className="text-yellow-500 font-bold mt-1">目前進度：{score % 100} / 100</p>
                                </div>
                            </div>
                        )}
                    </main>

                    {/* 頁尾 */}
                    <footer className="p-6 text-center text-slate-600 text-xs border-t border-slate-800 bg-slate-900/50">
                        <div>&copy; 2024 OT Exam Adventure.</div>
                        <div className="mt-1 italic">職能治療國考修煉系統 - 祝你順利奪金</div>
                    </footer>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
